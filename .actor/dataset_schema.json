{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": {"type": "string"},
      "source": {"type": "string"},
      "sourceName": {"type": "string"},
      "sourceUrl": {"type": "string", "format": "uri"},
      "jobTitle": {"type": "string"},
      "company": {"type": ["string", "null"]},
      "locations": {"type": "array", "items": {"type": "string"}},
      "remote": {"type": "boolean"},
      "tags": {"type": "array", "items": {"type": "string"}},
      "jobType": {"type": "array", "items": {"type": "string"}},
      "employmentType": {"type": ["string", "null"]},
      "seniority": {"type": "array", "items": {"type": "string"}},
      "timezoneRestrictions": {"type": "array", "items": {"type": "string"}},
      "categories": {"type": "array", "items": {"type": "string"}},
      "publishedAt": {"type": ["string", "null"], "format": "date-time"},
      "url": {"type": "string", "format": "uri"},
      "applyUrl": {"type": "string", "format": "uri"},
      "salary": {
        "type": ["object", "null"],
        "properties": {
          "min": {"type": ["number", "string", "null"]},
          "max": {"type": ["number", "string", "null"]},
          "currency": {"type": ["string", "null"]},
          "period": {"type": ["string", "null"]}
        }
      },
      "jobDescription": {"type": ["string", "null"]}
    }
  },
  "views": {
    "overview": {
      "title": "Remote jobs",
      "transformation": {"fields": ["jobTitle", "company", "locations", "publishedAt", "sourceName", "applyUrl"]},
      "display": {
        "component": "table",
        "properties": {
          "jobTitle": {"label": "Title", "format": "text"},
          "company": {"label": "Company", "format": "text"},
          "locations": {"label": "Location", "format": "array"},
          "publishedAt": {"label": "Published", "format": "date"},
          "sourceName": {"label": "Source", "format": "text"},
          "applyUrl": {"label": "Apply", "format": "link"}
        }
      }
    }
  }
}
