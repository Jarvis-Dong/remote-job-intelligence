{
  "$schema": "https://apify.com/schemas/v1/actor.ide.json",
  "actorSpecification": 1,
  "name": "remote-job-intelligence",
  "title": "Remote Jobs Aggregator API",
  "description": "Aggregate and deduplicate fresh remote jobs from four public feeds for alerts, job boards, and automation.",
  "version": "0.1",
  "buildTag": "latest",
  "readme": "../README.md",
  "dockerContextDir": "..",
  "minMemoryMbytes": 128,
  "defaultMemoryMbytes": 128,
  "maxMemoryMbytes": 256,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {"dataset": "./dataset_schema.json"},
  "dockerfile": "../Dockerfile"
}
